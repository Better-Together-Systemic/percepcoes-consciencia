# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# true quando atrás de proxy reverso/load balancer (para IP real no rate limit)
TRUST_PROXY=false

# Origem pública do frontend (dev: Vite em 5173; prod: o domínio do app)
APP_ORIGIN=http://localhost:5173

# ─── Persistência ────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ─── Sessão ──────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=8

# ─── IA (Claude) ─────────────────────────────────────────────
# Fica SOMENTE no servidor. Nunca exponha em variáveis VITE_*.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Admin inicial ───────────────────────────────────────────
# Usado apenas no primeiro boot (quando não existe nenhum admin).
# Depois de criado, remova ADMIN_PASSWORD do ambiente.
ADMIN_USERNAME=bettertogether
ADMIN_PASSWORD=

# ─── Produção ────────────────────────────────────────────────
# Caminho do build do frontend para a API servir o SPA na mesma origem.
# WEB_DIST_PATH=../web/dist
